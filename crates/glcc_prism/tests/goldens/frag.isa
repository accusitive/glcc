; prism ISA — generated by glcc -fprism --emit-isa
shader @fs_main : fragment
  dcl.input v0 : float2 semantic(TEXCOORD0)
  dcl.output o0 : float4 semantic(COLOR0)
  dcl.uniform u0 name(tint) c0=float4
  dcl.sampler s0 name(tex)
  %0 : float4 = sample s0, v0
  %2 : float = mov 0
  %4 : i32 = mov 0
  loop -> {
    %1 : float = phi [%2, entry], [%10, continue.0]
    %3 : i32 = phi [%4, entry], [%11, continue.0]
    %5 : i32 = cmp.lt %3, 3
    %6 : pred = setp.lt %3, 3
    if %6 -> {
      %7 : i32 = cmp.gt %0.x, 0.5
      %8 : float = add %1, %0.y
      %9 : float = sub %1, %0.z
      %10 : float = sel %7, %8, %9
      %11 : i32 = add %3, 1
      continue %10, %11
    } else {
      break
    }
  }
  %14 : float4 = mad %0, u0.c0, %1
  ret %14
