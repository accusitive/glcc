; prism ISA — generated by glcc -fprism --emit-isa
shader @vs_main : vertex
  dcl.input v0 : float4 semantic(POSITION)
  dcl.input v1 : float2 semantic(TEXCOORD0)
  dcl.output o0 : float4 semantic(POSITION)
  dcl.output o1 : float2 semantic(TEXCOORD0)
  dcl.uniform u0 name(mvp) c0=float4, c1=float4, c2=float4, c3=float4
  %6 : float = dp4 u0.c0.xyzw, v0.xyzw
  %13 : float = dp4 u0.c1.xyzw, v0.xyzw
  %20 : float = dp4 u0.c2.xyzw, v0.xyzw
  %27 : float = dp4 u0.c3.xyzw, v0.xyzw
  %28 : float4 = mov %6
  %29 : float4 = mov %13
  %30 : float4 = mov %20
  %31 : float4 = mov %27
  %32 : float2 = shuffle %28, %29 [0,5]
  %33 : float3 = shuffle %32, %30 [0,1,4]
  %34 : float4 = shuffle %33, %31 [0,1,2,4]
  %35 : float2 = mov v1
  ret %34, %35
