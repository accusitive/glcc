type Step<A> = | Done | Yield(A, Iterator<A>)
type Iterator<A> = | Iterator(Unit -> Step<A>)

fn next(it) : for<A> Iterator<A> -> Step<A> = match it {
    case Iterator(step) => step(())
}

fn empty() : for<A> -> Iterator<A> = Iterator(|u| Done)

fn cons(x, rest) : for<A> A -> Iterator<A> -> Iterator<A> = Iterator(|u| Yield(x, rest))

fn from_list(xs) : for<A> List<A> -> Iterator<A> = Iterator(|u| match xs {
    case Nil => Done
    case Cons(x, rest) => Yield(x, from_list(rest))
})

fn from_maybe(m) : for<A> Maybe<A> -> Iterator<A> = match m {
    case Nothing => empty()
    case Just(x) => cons(x, empty())
}

fn repeat(x) : for<A> A -> Iterator<A> = Iterator(|u| Yield(x, repeat(x)))

fn range(from, to) : Int -> Int -> Iterator<Int> =
    if from >= to then empty() else Iterator(|u| Yield(from, range(from + 1, to)))

fn iterate(f, x) : for<A> (A -> A) -> A -> Iterator<A> = Iterator(|u| Yield(x, iterate(f, f(x))))

fn map(f, it) : for<A, B> (A -> B) -> Iterator<A> -> Iterator<B> = Iterator(|u| match next(it) {
    case Done => Done
    case Yield(x, rest) => Yield(f(x), map(f, rest))
})

fn filter(p, it) : for<A> (A -> Bool) -> Iterator<A> -> Iterator<A> =
    Iterator(|u| advance(p, next(it)))

fn advance(p, step) : for<A> (A -> Bool) -> Step<A> -> Step<A> = match step {
    case Done => Done
    case Yield(x, rest) =>
        if p(x) then Yield(x, filter(p, rest))
        else advance(p, next(filter(p, rest)))
}

fn take(n, it) : for<A> Int -> Iterator<A> -> Iterator<A> =
    if n <= 0 then empty()
    else Iterator(|u| match next(it) {
        case Done => Done
        case Yield(x, rest) => Yield(x, take(n - 1, rest))
    })

fn drop(n, it) : for<A> Int -> Iterator<A> -> Iterator<A> = if n <= 0 then it else match next(it) {
    case Done => empty()
    case Yield(_, rest) => drop(n - 1, rest)
}

fn take_while(p, it) : for<A> (A -> Bool) -> Iterator<A> -> Iterator<A> = Iterator(|u| match next(it) {
    case Done => Done
    case Yield(x, rest) => if p(x) then Yield(x, take_while(p, rest)) else Done
})

fn drop_while(p, it) : for<A> (A -> Bool) -> Iterator<A> -> Iterator<A> = match next(it) {
    case Done => empty()
    case Yield(x, rest) => if p(x) then drop_while(p, rest) else cons(x, rest)
}

fn chain(first, second) : for<A> Iterator<A> -> Iterator<A> -> Iterator<A> = Iterator(|u| match next(first) {
    case Done => next(second)
    case Yield(x, rest) => Yield(x, chain(rest, second))
})

fn flat_map(f, it) : for<A, B> (A -> Iterator<B>) -> Iterator<A> -> Iterator<B> =
    Iterator(|u| match next(it) {
        case Done => Done
        case Yield(x, rest) => match next(f(x)) {
            case Done => next(flat_map(f, rest))
            case Yield(y, inner) => Yield(y, chain(inner, flat_map(f, rest)))
        }
    })

fn zip(first, second) : for<A, B> Iterator<A> -> Iterator<B> -> Iterator<(A, B)> = Iterator(|u| match next(first) {
    case Done => Done
    case Yield(x, first_rest) => match next(second) {
        case Done => Done
        case Yield(y, second_rest) => Yield((x, y), zip(first_rest, second_rest))
    }
})

fn enumerate(it) : for<A> Iterator<A> -> Iterator<(Int, A)> = enumerate_from(0, it)

fn enumerate_from(i, it) : for<A> Int -> Iterator<A> -> Iterator<(Int, A)> = Iterator(|u| match next(it) {
    case Done => Done
    case Yield(x, rest) => Yield((i, x), enumerate_from(i + 1, rest))
})

fn collect(it) : for<A> Iterator<A> -> List<A> = match next(it) {
    case Done => Nil
    case Yield(x, rest) => Cons(x, collect(rest))
}

fn fold(f, z, it) : for<A, B> ((B, A) -> B) -> B -> Iterator<A> -> B = match next(it) {
    case Done => z
    case Yield(x, rest) => fold(f, f(z, x), rest)
}

fn count(it) : for<A> Iterator<A> -> Int = fold(|n, _| n + 1, 0, it)

fn any(p, it) : for<A> (A -> Bool) -> Iterator<A> -> Bool = match next(it) {
    case Done => false
    case Yield(x, rest) => if p(x) then true else any(p, rest)
}

fn all(p, it) : for<A> (A -> Bool) -> Iterator<A> -> Bool = match next(it) {
    case Done => true
    case Yield(x, rest) => if p(x) then all(p, rest) else false
}

fn find(p, it) : for<A> (A -> Bool) -> Iterator<A> -> Maybe<A> = match next(it) {
    case Done => Nothing
    case Yield(x, rest) => if p(x) then Just(x) else find(p, rest)
}
