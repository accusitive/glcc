fn is_empty(xs) : for<A> List<A> -> Bool = match xs {
    case Nil => true
    case Cons(_, _) => false
}

fn length(xs) : for<A> List<A> -> Int = match xs {
    case Nil => 0
    case Cons(_, rest) => 1 + length(rest)
}

fn head(xs) : for<A> List<A> -> Maybe<A> = match xs {
    case Nil => Nothing
    case Cons(x, _) => Just(x)
}

fn last(xs) : for<A> List<A> -> Maybe<A> = match xs {
    case Nil => Nothing
    case Cons(x, Nil) => Just(x)
    case Cons(_, rest) => last(rest)
}

fn tail(xs) : for<A> List<A> -> List<A> = match xs {
    case Nil => Nil
    case Cons(_, rest) => rest
}

fn init(xs) : for<A> List<A> -> List<A> = match xs {
    case Nil => Nil
    case Cons(_, Nil) => Nil
    case Cons(x, rest) => Cons(x, init(rest))
}

fn map(f, xs) : for<A, B> (A -> B) -> List<A> -> List<B> = match xs {
    case Nil => Nil
    case Cons(x, rest) => Cons(f(x), map(f, rest))
}

fn filter(p, xs) : for<A> (A -> Bool) -> List<A> -> List<A> = match xs {
    case Nil => Nil
    case Cons(x, rest) => if p(x) then Cons(x, filter(p, rest)) else filter(p, rest)
}

fn foldl(f, z, xs) : for<A, B> ((B, A) -> B) -> B -> List<A> -> B = match xs {
    case Nil => z
    case Cons(x, rest) => foldl(f, f(z, x), rest)
}

fn foldr(f, z, xs) : for<A, B> ((A, B) -> B) -> B -> List<A> -> B = match xs {
    case Nil => z
    case Cons(x, rest) => f(x, foldr(f, z, rest))
}

fn any(p, xs) : for<A> (A -> Bool) -> List<A> -> Bool = match xs {
    case Nil => false
    case Cons(x, rest) => if p(x) then true else any(p, rest)
}

fn all(p, xs) : for<A> (A -> Bool) -> List<A> -> Bool = match xs {
    case Nil => true
    case Cons(x, rest) => if p(x) then all(p, rest) else false
}

fn find(p, xs) : for<A> (A -> Bool) -> List<A> -> Maybe<A> = match xs {
    case Nil => Nothing
    case Cons(x, rest) => if p(x) then Just(x) else find(p, rest)
}

fn find_index(p, xs) : for<A> (A -> Bool) -> List<A> -> Maybe<Int> = find_index_at(p, xs, 0)

fn find_index_at(p, xs, i) : for<A> (A -> Bool) -> List<A> -> Int -> Maybe<Int> = match xs {
    case Nil => Nothing
    case Cons(x, rest) => if p(x) then Just(i) else find_index_at(p, rest, i + 1)
}

fn contains(x, xs) : for<A> A -> List<A> -> Bool = any(|y| eq(x, y), xs)

fn take(n, xs) : for<A> Int -> List<A> -> List<A> = if n <= 0 then Nil else match xs {
    case Nil => Nil
    case Cons(x, rest) => Cons(x, take(n - 1, rest))
}

fn drop(n, xs) : for<A> Int -> List<A> -> List<A> = if n <= 0 then xs else match xs {
    case Nil => Nil
    case Cons(_, rest) => drop(n - 1, rest)
}

fn append(xs, ys) : for<A> List<A> -> List<A> -> List<A> = match xs {
    case Nil => ys
    case Cons(x, rest) => Cons(x, append(rest, ys))
}

fn reverse(xs) : for<A> List<A> -> List<A> = reverse_onto(xs, Nil)

fn reverse_onto(xs, acc) : for<A> List<A> -> List<A> -> List<A> = match xs {
    case Nil => acc
    case Cons(x, rest) => reverse_onto(rest, Cons(x, acc))
}

fn flatten(xss) : for<A> List<List<A>> -> List<A> = match xss {
    case Nil => Nil
    case Cons(xs, rest) => append(xs, flatten(rest))
}

fn zip(xs, ys) : for<A, B> List<A> -> List<B> -> List<(A, B)> = match xs {
    case Nil => Nil
    case Cons(x, xrest) => match ys {
        case Nil => Nil
        case Cons(y, yrest) => Cons((x, y), zip(xrest, yrest))
    }
}

fn enumerate(xs) : for<A> List<A> -> List<(Int, A)> = enumerate_at(xs, 0)

fn enumerate_at(xs, i) : for<A> List<A> -> Int -> List<(Int, A)> = match xs {
    case Nil => Nil
    case Cons(x, rest) => Cons((i, x), enumerate_at(rest, i + 1))
}

fn sum(xs) : List<Int> -> Int = foldl(|acc, x| acc + x, 0, xs)

fn product(xs) : List<Int> -> Int = foldl(|acc, x| acc * x, 1, xs)

fn range(from, to) : Int -> Int -> List<Int> =
    if from >= to then Nil else Cons(from, range(from + 1, to))

fn replicate(n, x) : for<A> Int -> A -> List<A> =
    if n <= 0 then Nil else Cons(x, replicate(n - 1, x))
