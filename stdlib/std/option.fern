import std::result

fn is_some(m) : for<A> Maybe<A> -> Bool = match m {
    case Nothing => false
    case Just(_) => true
}

fn is_none(m) : for<A> Maybe<A> -> Bool = match m {
    case Nothing => true
    case Just(_) => false
}

fn map(f, m) : for<A, B> (A -> B) -> Maybe<A> -> Maybe<B> = match m {
    case Nothing => Nothing
    case Just(x) => Just(f(x))
}

fn and_then(f, m) : for<A, B> (A -> Maybe<B>) -> Maybe<A> -> Maybe<B> = match m {
    case Nothing => Nothing
    case Just(x) => f(x)
}

fn filter(p, m) : for<A> (A -> Bool) -> Maybe<A> -> Maybe<A> = match m {
    case Nothing => Nothing
    case Just(x) => if p(x) then Just(x) else Nothing
}

fn unwrap_or(default, m) : for<A> A -> Maybe<A> -> A = match m {
    case Nothing => default
    case Just(x) => x
}

fn unwrap_or_else(f, m) : for<A> (Unit -> A) -> Maybe<A> -> A = match m {
    case Nothing => f(())
    case Just(x) => x
}

fn or_else(f, m) : for<A> (Unit -> Maybe<A>) -> Maybe<A> -> Maybe<A> = match m {
    case Nothing => f(())
    case Just(x) => Just(x)
}

fn flatten(m) : for<A> Maybe<Maybe<A>> -> Maybe<A> = match m {
    case Nothing => Nothing
    case Just(inner) => inner
}

fn to_list(m) : for<A> Maybe<A> -> List<A> = match m {
    case Nothing => Nil
    case Just(x) => Cons(x, Nil)
}

fn from_list(xs) : for<A> List<A> -> Maybe<A> = match xs {
    case Nil => Nothing
    case Cons(x, _) => Just(x)
}

fn to_result(error, m) : for<A, E> E -> Maybe<A> -> result.Result<A, E> = match m {
    case Nothing => result.Err(error)
    case Just(x) => result.Ok(x)
}
