type Result<A, E> = | Ok(A) | Err(E)

fn is_ok(r) : for<A, E> Result<A, E> -> Bool = match r {
    case Ok(_) => true
    case Err(_) => false
}

fn is_err(r) : for<A, E> Result<A, E> -> Bool = match r {
    case Ok(_) => false
    case Err(_) => true
}

fn map(f, r) : for<A, B, E> (A -> B) -> Result<A, E> -> Result<B, E> = match r {
    case Ok(x) => Ok(f(x))
    case Err(error) => Err(error)
}

fn map_err(f, r) : for<A, E, F> (E -> F) -> Result<A, E> -> Result<A, F> = match r {
    case Ok(x) => Ok(x)
    case Err(error) => Err(f(error))
}

fn and_then(f, r) : for<A, B, E> (A -> Result<B, E>) -> Result<A, E> -> Result<B, E> = match r {
    case Ok(x) => f(x)
    case Err(error) => Err(error)
}

fn or_else(f, r) : for<A, E, F> (E -> Result<A, F>) -> Result<A, E> -> Result<A, F> = match r {
    case Ok(x) => Ok(x)
    case Err(error) => f(error)
}

fn unwrap_or(default, r) : for<A, E> A -> Result<A, E> -> A = match r {
    case Ok(x) => x
    case Err(_) => default
}

fn unwrap_or_else(f, r) : for<A, E> (E -> A) -> Result<A, E> -> A = match r {
    case Ok(x) => x
    case Err(error) => f(error)
}

fn flatten(r) : for<A, E> Result<Result<A, E>, E> -> Result<A, E> = match r {
    case Ok(inner) => inner
    case Err(error) => Err(error)
}

fn to_maybe(r) : for<A, E> Result<A, E> -> Maybe<A> = match r {
    case Ok(x) => Just(x)
    case Err(_) => Nothing
}

fn to_list(r) : for<A, E> Result<A, E> -> List<A> = match r {
    case Ok(x) => Cons(x, Nil)
    case Err(_) => Nil
}

fn from_maybe(error, m) : for<A, E> E -> Maybe<A> -> Result<A, E> = match m {
    case Nothing => Err(error)
    case Just(x) => Ok(x)
}
